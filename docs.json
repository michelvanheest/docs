{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Covert_ Help Docs",
  "colors": {
    "primary": "#213ADE",
    "light": "#5F75FF",
    "dark": "#1129C8"
  },
  "fonts": {
    "heading": {
      "family": "General Sans",
      "weight": 600,
      "source": "https://fonts.cdnfonts.com/s/85793/GeneralSans-Semibold.woff",
      "format": "woff"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "description": "Welcome to Convert_'s Help Center! Here you can find everything you need to build your calculator, and we give answers to common questions.",
  "favicon": "/favicon.svg",
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Essentials",
            "pages": [
                "essentials/markdown",
                {
                    "group": "Test nested group",
                    "pages": [
                        "essentials/code",
                        "essentials/images",
                        "essentials/settings",
                        "essentials/navigation",
                        "essentials/reusable-snippets"
                    ]
                }
            ]
          }
        ]
      },
      {
        "dropdown": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint Examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Community",
          "href": "https://mintlify.com/community",
          "icon": "slack"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact support",
        "href": "mailto:support@convertcalculator.co"
      },
      {
        "label": "Open dashboard",
        "href": "https://www.convertstack.app/apps"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Visit website",
      "href": "https://www.convertcalculator.com/"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/convertcalc",
      "youtube": "https://www.youtube.com/channel/UC0WGV7vgmnBdDucSTFuRTSQ",
      "linkedin": "https://www.linkedin.com/company/convertcalculator/"
    }
  },
  "search": {
    "prompt": "Search anything"
  }
}